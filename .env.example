# ── Required tokens ──────────────────────────────────────────────────────────
# Run scripts/generate_config.sh to auto-generate these.
ADMIN_TOKEN=changeme
DATASETTE_TOKEN=changeme
EXPORT_TOKEN=changeme

# ── Optional tokens (only needed if using those features) ─────────────────────
# MCP server (Claude remote-MCP connector)
MCP_TOKEN=changeme

# ── App settings ──────────────────────────────────────────────────────────────
# Public URL of the app — used in OAuth redirect URIs
APP_BASE_URL=http://localhost:8080
# Your home timezone (IANA name)
HOME_TZ=America/New_York

# ── Data path ─────────────────────────────────────────────────────────────────
DB_PATH=/data/health.db

# ── Garmin (pick one method) ──────────────────────────────────────────────────
# Option A: session tokens (preferred — no 2FA friction)
# Run: python -c "from garminconnect import Garmin; g=Garmin(); g.login('email','pass'); print(g.garth.dumps())"
# then paste the JSON string here:
#GARMINTOKENS={"..."}

# Option B: email + password (may fail if Garmin requires 2FA)
#GARMIN_EMAIL=you@example.com
#GARMIN_PASSWORD=secret

# ── Google Health (optional) ──────────────────────────────────────────────────
# Create OAuth credentials at console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:8080/google_health_callback (or your APP_BASE_URL)
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# ── Litestream disaster-recovery backup (optional) ───────────────────────────
# Set to replicate the SQLite DB to S3/B2/R2.
# Examples:
#   s3://mybucket/health.db
#   s3://mybucket/health.db?endpoint=https://s3.us-east-005.backblazeb2.com&access-key-id=KEY&secret-access-key=SECRET
#LITESTREAM_REPLICA_URL=

# ── Morning webhook (optional) ────────────────────────────────────────────────
#MORNING_WEBHOOK_URL=
#MORNING_WEBHOOK_SECRET=
